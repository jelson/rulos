import glob
import os
import sys
sys.path.insert(0, "../../util")
from build_tools import *

# the weather icons, embedded as PNGs
icon_sources = LvglPngImages(
    sorted(glob.glob("icons/*.png")), os.path.join(BUILD_ROOT, "ntpclock", "icons"), prefix="icon_"
)

RulosBuildTarget(
    name = "ntpclock",
    sources = ["ntpclock.cpp", "clock_ui.c", "weather_icon.c"] + icon_sources,
    peripherals = "uart inet ntp lvgl ch422g weather openmeteo",
    extra_cflags = [
        "-DLOG_TO_SERIAL",

        # include out-of-repo directory to get wifi credentials
        "-I" + os.path.expanduser("~/.config/rulos"),
    ],
    platforms = [
        Esp32Platform(board=Esp32Boards.WAVESHARE_ESP32_S3_TOUCH_LCD_43B, lv_conf="lv_conf.h"),
    ],
).build()

# The same screen on the PC, fed from the system clock:
#   build/ntpclock-host/host/ntpclock-host [--screenshot FILE.bmp]
LvglHostProgram(
    "ntpclock-host",
    [
        "clock_host.c",
        "clock_ui.c",
        "weather_icon.c",
        "../../lib/periph/weather/weather.c",
        "../../lib/periph/openmeteo/openmeteo.c",
    ]
    + icon_sources,
    lv_conf_dir=".",
)
